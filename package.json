{
  "name": "react-native-watermelondb",
  "version": "0.1.2",
  "description": "react-native-watermelondb is a react native package built with Nitro",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "react-native": "src/index",
  "sideEffects": false,
  "source": "src/index",
  "scripts": {
    "typecheck": "bun check",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "specs": "nitrogen --logLevel=\"debug\"",
    "bench:js": "NODE_ENV=production node --expose-gc node_modules/jest/bin/jest.js -c test/bench/jest.config.js --runInBand",
    "bench:cpp": "mkdir -p .cache && c++ -std=c++20 -O2 -DNDEBUG -Icpp/core -Inode_modules/react-native-nitro-modules/cpp/core -Inode_modules/react-native-nitro-modules/cpp/utils cpp/core/SqliteDb.cpp cpp/core/DatabaseCore.cpp test/cpp/DatabaseCoreBench.cpp -lsqlite3 -o .cache/wmdb-core-bench && ./.cache/wmdb-core-bench",
    "test:cpp": "mkdir -p .cache && c++ -std=c++20 -Wall -Wextra -Icpp/core -Inode_modules/react-native-nitro-modules/cpp/core -Inode_modules/react-native-nitro-modules/cpp/utils cpp/core/SqliteDb.cpp cpp/core/DatabaseCore.cpp test/cpp/DatabaseCoreTest.cpp -lsqlite3 -o .cache/wmdb-core-test && ./.cache/wmdb-core-test",
    "clean": "git clean -dfX",
    "release": "semantic-release",
    "build": "bun run typecheck && bob build",
    "codegen": "nitrogen --logLevel=\"debug\" && bun run build",
    "postcodegen": "bun --cwd example pod",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "react-native-watermelondb"
  ],
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "cpp",
    "nitro.json",
    "android/build.gradle",
    "android/fix-prefab.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "ios/**/*.swift",
    "app.plugin.js",
    "*.podspec",
    "README.md",
    "!**/test.ts",
    "!**/*.test.*",
    "!**/__tests__",
    "!**/*.map"
  ],
  "workspaces": [
    "example"
  ],
  "repository": "https://github.com/nhonn/react-native-watermelondb.git",
  "author": "Noah Nguyen",
  "license": "MIT",
  "bugs": "https://github.com/nhonn/react-native-watermelondb/issues",
  "homepage": "https://github.com/nhonn/react-native-watermelondb#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7",
    "@nozbe/watermelondb": "0.28.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^26.6.5",
    "@types/react": "19.2.0",
    "@types/react-test-renderer": "^19.3.0",
    "babel-jest": "^29",
    "big-list-of-naughty-strings": "^1.0.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "jest": "^29",
    "nitrogen": "0.37.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "rxjs": "^7.8.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.18",
    "react-native-nitro-modules": "0.37.1",
    "react-test-renderer": "19.2.3",
    "semantic-release": "^25.0.7",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0",
    "react-native-nitro-modules": "*",
    "rxjs": "^7"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "configFile": "./babel.bob.config.js",
          "esm": true
        }
      ],
      [
        "module",
        {
          "configFile": "./babel.bob.config.js",
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": "**/{__tests__/**,__fixtures__/**,__mocks__/**,test.ts,test.tsx,*.test.ts,*.test.tsx}"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./*": {
      "source": "./src/*/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/*/index.d.ts",
        "default": "./lib/module/*/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/*/index.d.ts",
        "default": "./lib/commonjs/*/index.js"
      }
    },
    "./package.json": "./package.json"
  }
}
