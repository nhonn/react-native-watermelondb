{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/lib",
    "test/**",
    "**/__tests__/**",
    "**/__fixtures__/**",
    "**/__mocks__/**",
    "**/test.ts",
    "**/test.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "tsBuildInfoFile": "./lib/typescript/.tsbuildinfo"
  }
}
