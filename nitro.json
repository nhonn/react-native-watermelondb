{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "watermelondb"
  ],
  "ios": {
    "iosModuleName": "Watermelondb"
  },
  "android": {
    "androidNamespace": [
      "watermelondb"
    ],
    "androidCxxLibName": "Watermelondb"
  },
  "autolinking": {
    "NativeDatabaseFactory": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridNativeDatabaseFactory"
      }
    },
    "DatabasePaths": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridDatabasePaths"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridDatabasePaths"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
